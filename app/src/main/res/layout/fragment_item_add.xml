<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:context=".ui.packing.ItemAddFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_item_name" />

            <EditText
                android:id="@+id/et_item_name"
                style="@style/Widget.PackMate.Input"
                android:autofillHints=""
                android:hint="@string/hint_item_name"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_category" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input">

                <Spinner
                    android:id="@+id/spinner_category"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:text="@string/dropdown_arrow"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_category_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="의류 · 세면도구 · 전자기기 · 서류 · 의약품 · 기타" />

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_quantity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_minus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_minus"
                    android:gravity="center"
                    android:text="@string/btn_minus"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_quantity"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    tools:text="1" />

                <TextView
                    android:id="@+id/btn_plus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_plus"
                    android:gravity="center"
                    android:text="@string/btn_plus"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cb_save_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cb_save_default"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:buttonTint="@color/text_primary" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.PackMate.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.PackMate.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_save" />
    </LinearLayout>
</LinearLayout>
