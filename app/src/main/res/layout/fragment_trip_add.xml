<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:context=".ui.trip.TripAddFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_trip_name" />

            <EditText
                android:id="@+id/et_trip_name"
                style="@style/Widget.PackMate.Input"
                android:autofillHints=""
                android:hint="@string/hint_trip_name"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_place" />

            <EditText
                android:id="@+id/et_place"
                style="@style/Widget.PackMate.Input"
                android:autofillHints=""
                android:hint="@string/hint_place"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_start_date" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 직접 입력하지 않고 누르면 DatePickerDialog를 띄운다 -->
                <EditText
                    android:id="@+id/et_start_date"
                    style="@style/Widget.PackMate.Input"
                    android:autofillHints=""
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:hint="@string/hint_start_date"
                    android:inputType="none"
                    android:longClickable="false"
                    android:paddingEnd="48dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:text="@string/icon_calendar"
                    android:textSize="20sp" />
            </FrameLayout>

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_days" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input">

                <Spinner
                    android:id="@+id/spinner_days"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:text="@string/dropdown_arrow"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />
            </FrameLayout>

            <TextView
                style="@style/Widget.PackMate.FieldLabel"
                android:text="@string/label_emoji" />

            <LinearLayout
                android:id="@+id/layout_emojis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:orientation="horizontal"
                android:padding="6dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.PackMate.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.PackMate.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_save" />
    </LinearLayout>
</LinearLayout>
