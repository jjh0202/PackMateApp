<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 와이어프레임과 같은 밝은 흑백 화면으로 고정 -->
    <style name="Base.Theme.PackMateApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/text_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PackMateApp" parent="Base.Theme.PackMateApp" />

    <!-- 흰 바탕 + 진한 테두리 버튼 (취소, 기본 짐 불러오기 등) -->
    <style name="Widget.PackMate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border_dark</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- 회색 바탕 + 진한 테두리 버튼 (저장, + 짐 추가 등) -->
    <style name="Widget.PackMate.Button.Filled" parent="Widget.PackMate.Button.Outlined">
        <item name="backgroundTint">@color/button_fill</item>
    </style>

    <!-- 입력 칸 위의 라벨 -->
    <style name="Widget.PackMate.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 테두리 있는 입력 칸 -->
    <style name="Widget.PackMate.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="ShapeAppearance.PackMate.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
